# Server
NODE_ENV=production
PORT=10000

# Session Secret (generate a random 64-char string)
SESSION_SECRET=CHANGE_ME_generate_a_64_character_random_string_here

# Admin Credentials (use 'node scripts/hash-password.js <password>' to generate)
ADMIN_EMAIL=admin@noorwallarts.com
ADMIN_PASSWORD_HASH=$2a$12$CHANGE_ME_run_hash_script

# Payment Settings PIN (use 'node scripts/hash-password.js <6-digit-pin>' to generate)
PAYMENT_PIN_HASH=$2a$12$CHANGE_ME_run_hash_script

# Razorpay
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# CORS
ALLOWED_ORIGIN=https://your-domain.onrender.com

# Firebase Admin (path to service account JSON)
GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json
